<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.citastecnicas.controller.CitasTecnicasController" prefWidth="1100.0" prefHeight="700.0" styleClass="app-view" stylesheets="@../css/root.css">
    <top>
        <VBox spacing="5.0" styleClass="view-header">
            <Label text="Gestión de citas técnicas" styleClass="view-title" />
            <Label text="TecnoAsistencia Nicaragua S.A. · Agenda de atención y servicios" styleClass="view-subtitle" />
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.32" styleClass="content-split">
            <VBox spacing="14.0" minWidth="290.0" styleClass="form-card">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" VBox.vgrow="ALWAYS">
                    <VBox spacing="10.0">
                        <VBox spacing="4.0">
                            <Label text="Datos de la cita" styleClass="section-title" />
                            <Label text="* Campos obligatorios" styleClass="muted-label" />
                        </VBox>
                        <Separator />
                        <VBox spacing="5.0">
                            <Label text="Cliente *" styleClass="field-label" />
                            <ComboBox fx:id="clientComboBox" promptText="Seleccionar cliente" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Fecha *" styleClass="field-label" />
                            <DatePicker fx:id="datePicker" promptText="dd/mm/aaaa" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Hora *" styleClass="field-label" />
                            <TextField fx:id="timeField" promptText="HH:mm · Ej. 09:30" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Tipo de servicio *" styleClass="field-label" />
                            <TextField fx:id="serviceTypeField" promptText="Ej. Mantenimiento preventivo" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Descripción *" styleClass="field-label" />
                            <TextArea fx:id="descriptionArea" promptText="Detalles de la cita" prefRowCount="3" wrapText="true" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Estado *" styleClass="field-label" />
                            <ComboBox fx:id="statusComboBox" promptText="Seleccionar estado" maxWidth="Infinity" />
                        </VBox>
                    </VBox>
                </ScrollPane>
                <Separator />
                <GridPane hgap="8.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Button fx:id="saveButton" text="Guardar" maxWidth="Infinity" styleClass="button-primary" onAction="#onSave" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Button fx:id="editButton" text="Actualizar" maxWidth="Infinity" onAction="#onEdit" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Button fx:id="clearButton" text="Limpiar" maxWidth="Infinity" onAction="#onClear" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Button fx:id="deleteButton" text="Eliminar" maxWidth="Infinity" styleClass="button-danger" onAction="#onDelete" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </GridPane>
            </VBox>
            <VBox spacing="14.0" minWidth="540.0" styleClass="data-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Listado de citas" styleClass="section-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="recordCountLabel" text="0 registros" styleClass="record-count" />
                </HBox>
                <FlowPane hgap="8.0" vgap="10.0" rowValignment="BOTTOM" styleClass="toolbar">
                    <VBox spacing="5.0">
                        <Label text="Estado" styleClass="field-label" />
                        <ComboBox fx:id="filterStatusComboBox" promptText="Todos" prefWidth="135.0" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="Fecha" styleClass="field-label" />
                        <DatePicker fx:id="filterDatePicker" promptText="Todas" prefWidth="145.0" />
                    </VBox>
                    <Button text="Filtrar" styleClass="button-primary" onAction="#onFilter" />
                    <Button text="Limpiar filtros" onAction="#onClearFilters" />
                </FlowPane>
                <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS" onMouseClicked="#onTableRowClicked">
                    <placeholder>
                        <Label text="No hay citas para mostrar" styleClass="empty-label" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="55.0" minWidth="45.0" />
                        <TableColumn fx:id="colClient" text="Cliente" prefWidth="180.0" minWidth="130.0" />
                        <TableColumn fx:id="colDate" text="Fecha" prefWidth="110.0" minWidth="90.0" />
                        <TableColumn fx:id="colTime" text="Hora" prefWidth="80.0" minWidth="65.0" />
                        <TableColumn fx:id="colService" text="Servicio" prefWidth="170.0" minWidth="110.0" />
                        <TableColumn fx:id="colStatus" text="Estado" prefWidth="115.0" minWidth="105.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <Label text="Seleccioná una cita para editarla o eliminarla." styleClass="muted-label" />
        </HBox>
    </bottom>
</BorderPane>
