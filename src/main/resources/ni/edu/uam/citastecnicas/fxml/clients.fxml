<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.citastecnicas.controller.ClientController" prefWidth="1100.0" prefHeight="700.0" styleClass="app-view" stylesheets="@../css/root.css">
    <top>
        <VBox spacing="5.0" styleClass="view-header">
            <Label text="Gestión de clientes" styleClass="view-title" />
            <Label text="TecnoAsistencia Nicaragua S.A. · Registro y datos de contacto" styleClass="view-subtitle" />
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.32" styleClass="content-split">
            <VBox spacing="14.0" minWidth="290.0" styleClass="form-card">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" VBox.vgrow="ALWAYS">
                    <VBox spacing="10.0">
                        <VBox spacing="4.0">
                            <Label text="Datos del cliente" styleClass="section-title" />
                            <Label text="* Campos obligatorios" styleClass="muted-label" />
                        </VBox>
                        <Separator />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="ID" styleClass="field-label" />
                            <TextField fx:id="txtId" promptText="Automático" editable="false" disable="true" prefWidth="110.0" />
                        </HBox>
                        <VBox spacing="5.0">
                            <Label text="Nombres *" styleClass="field-label" />
                            <TextField fx:id="txtNombres" promptText="Ingresá los nombres" />
                            <Label fx:id="lblErrorNombres" styleClass="error-label" visible="false" managed="false" wrapText="true" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Apellidos *" styleClass="field-label" />
                            <TextField fx:id="txtApellidos" promptText="Ingresá los apellidos" />
                            <Label fx:id="lblErrorApellidos" styleClass="error-label" visible="false" managed="false" wrapText="true" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Teléfono *" styleClass="field-label" />
                            <TextField fx:id="txtTelefono" promptText="Ej. 8888-9999" />
                            <Label fx:id="lblErrorTelefono" styleClass="error-label" visible="false" managed="false" wrapText="true" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Correo *" styleClass="field-label" />
                            <TextField fx:id="txtCorreo" promptText="nombre@correo.com" />
                            <Label fx:id="lblErrorCorreo" styleClass="error-label" visible="false" managed="false" wrapText="true" />
                        </VBox>
                        <CheckBox fx:id="chkActivo" text="Cliente activo" selected="true" />
                    </VBox>
                </ScrollPane>
                <Separator />
                <GridPane hgap="8.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Button fx:id="btnGuardar" text="Guardar" maxWidth="Infinity" styleClass="button-primary" onAction="#onGuardar" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Button fx:id="btnActualizar" text="Actualizar" maxWidth="Infinity" disable="true" onAction="#onActualizar" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Button fx:id="btnLimpiar" text="Limpiar" maxWidth="Infinity" onAction="#onLimpiar" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Button fx:id="btnEliminar" text="Eliminar" maxWidth="Infinity" styleClass="button-danger" disable="true" onAction="#onEliminar" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </GridPane>
            </VBox>
            <VBox spacing="14.0" minWidth="540.0" styleClass="data-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Listado de clientes" styleClass="section-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblContador" text="Total: 0 clientes" styleClass="record-count" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="toolbar">
                    <Label text="Buscar" styleClass="field-label" />
                    <TextField fx:id="txtBuscar" promptText="Nombres, apellidos o correo" HBox.hgrow="ALWAYS" onKeyReleased="#onBuscar" />
                    <Button fx:id="btnLimpiarBusqueda" text="Limpiar" onAction="#onLimpiarBusqueda" />
                </HBox>
                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No hay clientes para mostrar" styleClass="empty-label" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="55.0" minWidth="45.0" />
                        <TableColumn fx:id="colNombres" text="Nombres" prefWidth="140.0" minWidth="90.0" />
                        <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="140.0" minWidth="90.0" />
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110.0" minWidth="95.0" />
                        <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180.0" minWidth="130.0" />
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0" minWidth="90.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <Label fx:id="lblEstado" text="Seleccioná un cliente para editarlo o eliminarlo." styleClass="muted-label" />
        </HBox>
    </bottom>
</BorderPane>
