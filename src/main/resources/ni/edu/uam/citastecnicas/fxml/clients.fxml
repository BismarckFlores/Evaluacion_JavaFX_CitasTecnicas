<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.citastecnicas.controller.ClientController"
            prefHeight="650.0" prefWidth="980.0">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>

    <!-- Encabezado Superior y Barra de Búsqueda (RF05) -->
    <top>
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <VBox spacing="2.0">
                    <Label text="Gestión de Clientes">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Label text="TecnoAsistencia Nicaragua S.A. — Módulo de Clientes" textFill="#616161">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Label>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Búsqueda rápida por nombres, apellidos o correo -->
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Label text="Buscar:" />
                    <TextField fx:id="txtBuscar" promptText="Nombres, apellidos o correo..."
                               prefWidth="260.0" onKeyReleased="#onBuscar" />
                    <Button fx:id="btnLimpiarBusqueda" text="Limpiar" onAction="#onLimpiarBusqueda" />
                </HBox>
            </HBox>
            <Separator />
        </VBox>
    </top>

    <!-- Área Principal: Formulario a la izquierda y Tabla a la derecha -->
    <center>
        <HBox spacing="15.0">
            <padding>
                <Insets top="10.0" bottom="10.0" />
            </padding>

            <!-- Formulario de Clientes -->
            <VBox prefWidth="320.0" minWidth="280.0" spacing="10.0">
                <Label text="Formulario de Cliente">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <!-- Campo ID (Identificador interno solo lectura) -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="ID:" prefWidth="60.0" />
                    <TextField fx:id="txtId" promptText="Auto" editable="false" disable="true" prefWidth="80.0" />
                </HBox>

                <!-- Campo Nombres -->
                <VBox spacing="3.0">
                    <Label text="Nombres: *" />
                    <TextField fx:id="txtNombres" promptText="Ingrese los nombres" />
                    <Label fx:id="lblErrorNombres" textFill="#d32f2f" visible="false" managed="false">
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Campo Apellidos -->
                <VBox spacing="3.0">
                    <Label text="Apellidos: *" />
                    <TextField fx:id="txtApellidos" promptText="Ingrese los apellidos" />
                    <Label fx:id="lblErrorApellidos" textFill="#d32f2f" visible="false" managed="false">
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Campo Teléfono -->
                <VBox spacing="3.0">
                    <Label text="Teléfono: *" />
                    <TextField fx:id="txtTelefono" promptText="Ej. 8888-9999" />
                    <Label fx:id="lblErrorTelefono" textFill="#d32f2f" visible="false" managed="false">
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Campo Correo -->
                <VBox spacing="3.0">
                    <Label text="Correo: *" />
                    <TextField fx:id="txtCorreo" promptText="Ej. cliente@correo.com" />
                    <Label fx:id="lblErrorCorreo" textFill="#d32f2f" visible="false" managed="false">
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Estado Activo -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Estado:" prefWidth="60.0" />
                    <CheckBox fx:id="chkActivo" text="Activo" selected="true" />
                </HBox>

                <Separator />

                <!-- Botones CRUD (RF02) -->
                <VBox spacing="8.0">
                    <HBox spacing="8.0">
                        <Button fx:id="btnGuardar" text="Guardar" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onGuardar" />
                        <Button fx:id="btnActualizar" text="Actualizar" maxWidth="Infinity" HBox.hgrow="ALWAYS" disable="true" onAction="#onActualizar" />
                    </HBox>
                    <HBox spacing="8.0">
                        <Button fx:id="btnLimpiar" text="Limpiar / Nuevo" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onLimpiar" />
                        <Button fx:id="btnEliminar" text="Eliminar" maxWidth="Infinity" HBox.hgrow="ALWAYS" disable="true" onAction="#onEliminar" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Tabla de Clientes -->
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Listado de Clientes">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblContador" text="Total: 0 clientes" textFill="#546e7a">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                </HBox>

                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="55.0" />
                        <TableColumn fx:id="colNombres" text="Nombres" prefWidth="150.0" />
                        <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="150.0" />
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110.0" />
                        <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190.0" />
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="85.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <!-- Barra Inferior de Estado -->
    <bottom>
        <VBox spacing="5.0">
            <Separator />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label fx:id="lblEstado" text="Listo." textFill="#546e7a" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
